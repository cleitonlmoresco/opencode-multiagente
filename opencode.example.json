    "plan": { "model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b" }
  },
  "providers": {
    "openrouter": {}
  },
  "mcp": {
    "exemplo": {
      "type": "local",
      "command": ["python", "servidor_mcp.py"],
      "enabled": false
    }
  }
}
